+void GCodePlanner::addPolyLinesByOptimizer(Polygons& lines, GCodePathConfig* config)
+{
+    vector<bool> done(lines.size(), false);
+    Point here = lastPosition;
+    for (unsigned int n = 0; n < lines.size(); n++)
+    {
+        int best = -1;
+        bool reversed = false;
+        int64_t bestDist = 0;
+        for (unsigned int i = 0; i < lines.size(); i++)
+        {
+            if (done[i] || lines[i].size() < 1)
+                continue;
+            int64_t d0 = vSize2(lines[i][0] - here), d1 = vSize2(lines[i][lines[i].size() - 1] - here);
+            if (best < 0 || d0 < bestDist) { best = i; bestDist = d0; reversed = false; }
+            if (d1 < bestDist) { best = i; bestDist = d1; reversed = true; }
+        }
+        if (best < 0)
+            break;
+        done[best] = true;
+        PolygonRef l = lines[best];
+        unsigned int count = l.size();
+        addTravel(l[reversed ? count - 1 : 0]);
+        for (unsigned int j = 1; j < count; j++)
+            addExtrusionMove(l[reversed ? count - 1 - j : j], config);
+        here = l[reversed ? 0 : count - 1];
+    }
+}
